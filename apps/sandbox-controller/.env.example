
SANDBOX_IMAGE=code-review-agent-sandbox:latest
SANDBOX_RUNTIME=runsc
SANDBOX_MEMORY=1536m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_COMMAND_TIMEOUT_SECONDS=60
SANDBOX_MAX_LIFETIME_SECONDS=600
SANDBOX_MAX_CONCURRENT=2
SANDBOX_NETWORK=code-review-agent-sandbox
SANDBOX_LABEL_PREFIX=code-review-agent

SANDBOX_CONTROLLER_TOKEN=replace-me