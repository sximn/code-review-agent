OPENAI_API_KEY=sk-proj-...
MODEL=gpt-4o-mini

# modes: | live | simulation | mock |
AGENT_MODE=simulation
# simulation runs the real SDK, sandbox tools, usage and estimates costs
# scenarios: | success | findings | api-error | error-after-tool | invalid-output | missing-usage | step-limit |
SIMULATION_SCENARIO=success

GITHUB_TOKEN=github_pat_...

NODE_ENV=development

BETTER_AUTH_SECRET=my-better-auth-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

REDIS_PASSWORD=redis-pwd

POSTGRES_USER=user
POSTGRES_PASSWORD=user-s-password

REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/postgres
MIGRATION_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/postgres

DRIZZLE_STUDIO_PASSWORD=drizzle-studio-pass

GOOGLE_CLIENT_ID=google-clinet-id
GOOGLE_CLIENT_SECRET=google-client-secret

GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret

JOB_STREAM="jobs"
REVIEW_JOB_NAME="pr-review"
GROUP_NAME="workers"
JOB_RECLAIM_TIMEOUT_SECONDS=360
RECOVERY_INTERVAL_SECONDS=60
JOB_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=2
WORKER_API_TOKEN=replace-with-at-least-32-random-characters

COMPLETION_KEY_PREFIX="review-completions"
COMPLETION_DLQ_STREAM="review-completion-dlq"
COMPLETION_MAX_DELIVERY_ATTEMPTS=5

SANDBOX_CONTROLLER_URL=http://sandbox-controller:8000
SANDBOX_CONTROLLER_TOKEN=replace-me

SANDBOX_IMAGE=code-review-agent-sandbox:latest
# "runsc" - gVisor on Linux | "runc" - dev mode (macos compatible)
SANDBOX_RUNTIME=runc
SANDBOX_MEMORY=1536m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_COMMAND_TIMEOUT_SECONDS=60
SANDBOX_MAX_LIFETIME_SECONDS=600
SANDBOX_MAX_CONCURRENT=2
SANDBOX_NETWORK=code-review-agent-sandbox
SANDBOX_LABEL_PREFIX=code-review-agent
