{
  "info": {
    "title": "REWY API",
    "version": "1.0.0",
    "description": "Typed API for repository management and AI code review workflows."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      },
      "workerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "worker token"
      }
    },
    "schemas": {
      "PublicRepository": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$"
          }
        },
        "required": [
          "fullName"
        ],
        "additionalProperties": false
      },
      "UndefinedError": {
        "title": "UndefinedError",
        "type": "object",
        "properties": {
          "defined": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "Unauthorized": {
        "title": "UNAUTHORIZED",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "UNAUTHORIZED"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "InvalidRepository": {
        "title": "INVALID_REPOSITORY",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "INVALID_REPOSITORY"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "RepositoryNotFound": {
        "title": "REPOSITORY_NOT_FOUND",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REPOSITORY_NOT_FOUND"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "GithubUnavailable": {
        "title": "GITHUB_UNAVAILABLE",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "GITHUB_UNAVAILABLE"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "RepositorySaveFailed": {
        "title": "REPOSITORY_SAVE_FAILED",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REPOSITORY_SAVE_FAILED"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "ConnectedRepository": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fullName": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^/\\s]+$"
          }
        },
        "required": [
          "id",
          "fullName"
        ],
        "additionalProperties": false
      },
      "PullRequest": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "x-native-type": "date"
          }
        },
        "required": [
          "number",
          "url",
          "title",
          "description",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "RepositoryReviewWithUsage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "repositoryId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "pullRequestNumber": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "running",
              "finished",
              "failed"
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "x-native-type": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "x-native-type": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "x-native-type": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "x-native-type": "date"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StoredReviewUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "repositoryId",
          "pullRequestNumber",
          "status",
          "result",
          "error",
          "startedAt",
          "finishedAt",
          "updatedAt",
          "createdAt",
          "usage"
        ],
        "additionalProperties": false
      },
      "ReviewResult": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "approval_granted": {
            "type": "boolean"
          }
        },
        "required": [
          "findings",
          "approval_granted"
        ],
        "additionalProperties": false
      },
      "Finding": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "quality",
              "performance",
              "security"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line_start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "line_end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "category",
          "severity",
          "title",
          "description",
          "file",
          "line_start",
          "line_end",
          "evidence",
          "recommendation",
          "confidence"
        ],
        "additionalProperties": false
      },
      "StoredReviewUsage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reviewId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "requestCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "responsesWithUsage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cachedInputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cacheWriteTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasoningTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "estimatedCostUsd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "reviewId",
          "requestCount",
          "responsesWithUsage",
          "inputTokens",
          "cachedInputTokens",
          "cacheWriteTokens",
          "outputTokens",
          "reasoningTokens",
          "totalTokens",
          "estimatedCostUsd"
        ],
        "additionalProperties": false
      },
      "RepositoryReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "repositoryId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "pullRequestNumber": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "running",
              "finished",
              "failed"
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "x-native-type": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "x-native-type": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "x-native-type": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "x-native-type": "date"
          }
        },
        "required": [
          "id",
          "repositoryId",
          "pullRequestNumber",
          "status",
          "result",
          "error",
          "startedAt",
          "finishedAt",
          "updatedAt",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ReviewQueueUnavailable": {
        "title": "REVIEW_QUEUE_UNAVAILABLE",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REVIEW_QUEUE_UNAVAILABLE"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "ReviewCreateFailed": {
        "title": "REVIEW_CREATE_FAILED",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REVIEW_CREATE_FAILED"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "ReviewUsage": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "const": "openai"
          },
          "request_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "responses_with_usage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "responses_without_usage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cache_write_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasoning_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelUsage"
            }
          }
        },
        "required": [
          "provider",
          "request_count",
          "responses_with_usage",
          "responses_without_usage",
          "input_tokens",
          "cached_input_tokens",
          "cache_write_tokens",
          "output_tokens",
          "reasoning_tokens",
          "total_tokens",
          "models"
        ],
        "additionalProperties": false
      },
      "ModelUsage": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "request_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "responses_with_usage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cached_input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cache_write_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reasoning_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "model",
          "request_count",
          "responses_with_usage",
          "input_tokens",
          "cached_input_tokens",
          "cache_write_tokens",
          "output_tokens",
          "reasoning_tokens",
          "total_tokens"
        ],
        "additionalProperties": false
      },
      "ReviewCost": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "estimated",
              "unsupported-model",
              "usage-unavailable",
              "not-applicable"
            ]
          },
          "estimated_usd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pricing_version": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "partial": {
            "type": "boolean"
          },
          "unsupported_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "estimated_usd",
          "pricing_version",
          "partial",
          "unsupported_models"
        ],
        "additionalProperties": false
      },
      "ReviewNotFound": {
        "title": "REVIEW_NOT_FOUND",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REVIEW_NOT_FOUND"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "defined",
          "code",
          "message"
        ]
      },
      "ReviewStateConflict": {
        "title": "REVIEW_STATE_CONFLICT",
        "type": "object",
        "properties": {
          "defined": {
            "const": true
          },
          "code": {
            "const": "REVIEW_STATE_CONFLICT"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "currentStatus": {
                "type": "string"
              }
            },
            "required": [
              "currentStatus"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "defined",
          "code",
          "message",
          "data"
        ]
      }
    }
  },
  "openapi": "3.1.1",
  "paths": {
    "/repositories/check": {
      "post": {
        "operationId": "checkRepository",
        "summary": "Check access to a public GitHub repository",
        "tags": [
          "Repositories"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[^/\\s]+\\/[^/\\s]+$"
                  }
                },
                "required": [
                  "repository"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "$ref": "#/components/schemas/PublicRepository"
                    }
                  },
                  "required": [
                    "repository"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Enter a repository in owner/repository format.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/InvalidRepository"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Unauthorized"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The repository could not be found or is not connected.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RepositoryNotFound"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "GitHub is unavailable. Please try again shortly., The repository could not be connected.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/GithubUnavailable"
                    },
                    {
                      "$ref": "#/components/schemas/RepositorySaveFailed"
                    },
                    {
                      "$ref": "#/components/schemas/UndefinedError"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/repositories": {
